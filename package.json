{
  "name": "unicode-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "data": "python3 scripts/build_data.py",
    "tiles": "node scripts/build_tiles.ts",
    "about": "node scripts/build_about.ts",
    "dev": "vp dev",
    "build": "node scripts/css-module-types.ts && tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "node scripts/css-module-types.ts && tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "knip": "knip",
    "check": "node scripts/css-module-types.ts && vp check && knip && vp test run"
  },
  "dependencies": {
    "d3-interpolate": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-interpolate": "^3.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.45.1",
    "oxlint-plugin-eslint": "1.93.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
